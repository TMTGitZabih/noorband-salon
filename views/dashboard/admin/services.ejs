<div class="dash-header">
  <h2>Manage Services</h2>
  <p>Add and edit the services your salon offers.</p>
</div>

<div class="dash-grid-2">
  <div class="card dash-form">
    <h3>Add New Service</h3>
    <form action="/admin/services" method="POST">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required />

      <label for="category">Category</label>
      <select id="category" name="category">
        <option>Makeup</option>
        <option>Hair Styling</option>
        <option>Hair Coloring</option>
        <option>Hair Cutting</option>
        <option>Facial</option>
        <option>Skincare</option>
        <option>Eyebrows</option>
        <option>Henna</option>
        <option>Other</option>
      </select>

      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3"></textarea>

      <div class="form-row-2">
        <div>
          <label for="price">Price ($)</label>
          <input type="number" id="price" name="price" min="0" step="0.01" required />
        </div>
        <div>
          <label for="durationMinutes">Duration (minutes)</label>
          <input type="number" id="durationMinutes" name="durationMinutes" min="15" step="15" required />
        </div>
      </div>

      <label for="image">Image URL</label>
      <input type="text" id="image" name="image" placeholder="/images/gallery/placeholder.jpg" />

      <button type="submit" class="btn btn-primary">Add Service</button>
    </form>
  </div>

  <div class="card">
    <h3>Existing Services</h3>
    <table class="data-table">
      <thead><tr><th>Name</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% services.forEach(function(s) { %>
          <tr data-service-row="<%= s._id %>">
            <td><%= s.name %></td>
            <td>Rs <%= s.price %></td>
            <td>
              <form action="/admin/services/<%= s._id %>" method="POST" class="inline-toggle-form">
                <input type="hidden" name="name" value="<%= s.name %>" />
                <input type="hidden" name="category" value="<%= s.category %>" />
                <input type="hidden" name="description" value="<%= s.description %>" />
                <input type="hidden" name="price" value="<%= s.price %>" />
                <input type="hidden" name="durationMinutes" value="<%= s.durationMinutes %>" />
                <input type="hidden" name="image" value="<%= s.image %>" />
                <label class="wh-check">
                  <input type="checkbox" name="isActive" onchange="this.form.submit()" <%= s.isActive ? 'checked' : '' %> />
                  Active
                </label>
              </form>
            </td>
            <td class="table-actions">
              <button class="btn btn-sm btn-danger" data-action="delete-service" data-id="<%= s._id %>">Delete</button>
            </td>
          </tr>
        <% }) %>
        <% if (!services.length) { %>
          <tr><td colspan="4" class="empty-state">No services yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
