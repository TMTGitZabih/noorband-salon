<section class="page-hero">
  <div class="container">
    <h1>Our Services</h1>
    <p>Explore everything <%= salon.name %> has to offer</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% var categories = Object.keys(grouped); %>
    <% if (!categories.length) { %>
      <p class="empty-state center">Services will appear here once added by the admin.</p>
    <% } %>
    <div class="grid grid-3">
      <% categories.forEach(function(cat) { %>
        <% grouped[cat].forEach(function(s) { %>
          <div class="card service-card">
            <div class="card-image" style="background-image:url('<%= s.image %>')"></div>
            <div class="card-body">
              <span class="service-category-tag"><%= cat %></span>
              <h3><%= s.name %></h3>
              <p><%= s.description %></p>
              <div class="card-meta">
                <span class="price">Rs <%= s.price %></span>
                <span class="duration"><%= s.durationMinutes %> min</span>
              </div>
              <a href="/book" class="btn btn-outline btn-sm">Book This Service</a>
            </div>
          </div>
        <% }) %>
      <% }) %>
    </div>
  </div>
</section>
