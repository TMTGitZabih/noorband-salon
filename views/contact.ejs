<section class="page-hero">
  <div class="container">
    <h1>Contact Us</h1>
    <p>We'd love to hear from you</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <div class="card contact-form-card">
      <h2>Send a Message</h2>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form action="/contact" method="POST" class="contact-form">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />

        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />

        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>

        <button type="submit" class="btn btn-primary btn-block">Send Message</button>
      </form>
    </div>

    <div class="contact-info-col">
      <div class="card">
        <h3>Get in Touch</h3>
        <p><strong>Phone</strong><br><a href="tel:<%= salon.phone %>"><%= salon.phone %></a></p>
        <p><strong>WhatsApp</strong><br><a href="https://wa.me/<%= (salon.whatsapp||'').replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener"><%= salon.whatsapp %></a></p>
        <p><strong>Email</strong><br><a href="mailto:<%= salon.email %>"><%= salon.email %></a></p>
        <p><strong>Address</strong><br><%= salon.address %></p>
        <h4>Opening Hours</h4>
        <ul class="hours-list">
          <% (salon.openingHours || []).forEach(function(oh) { %>
            <li><span><%= oh.day %></span><span><%= oh.hours %></span></li>
          <% }) %>
        </ul>
      </div>
      <div class="card map-card">
        <iframe
          title="Salon location"
          src="https://www.google.com/maps?q=<%= encodeURIComponent(salon.address || salon.name) %>&output=embed"
          width="100%" height="260" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</section>
