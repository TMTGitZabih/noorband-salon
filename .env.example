# ------- Server -------
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ------- Database -------
# MongoDB Atlas connection string (Database Access user, NOT your Atlas login)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>/noorband_salon?retryWrites=true&w=majority

# ------- Sessions -------
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# ------- Admin bootstrap (used by npm run seed) -------
ADMIN_NAME=Salon Admin
ADMIN_EMAIL=admin@noorbandsalon.online
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=+10000000000

# ------- WhatsApp OTP verification (Twilio) -------
# Leave blank during development: OTP codes will be printed to the server console instead of sent.
# Get these from https://www.twilio.com/console after setting up WhatsApp sending on your Twilio number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------- Salon info (used across the site) -------
SALON_NAME=NoorBand Salon
SALON_PHONE=+10000000000
SALON_WHATSAPP=+10000000000
SALON_EMAIL=info@noorbandsalon.online
SALON_ADDRESS=Your Salon Address, City
